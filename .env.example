# Host sign-in. Do not commit real values.
# On local dev and Vercel Preview, if these are unset, the app uses a placeholder seed:
#   email: host@example.com
#   password: preview-seed-change-me
# Production ignores that seed. Set all three before any production use.
HOST_EMAIL=
# bcrypt hash, not the password itself:
# node -e "console.log(require('bcryptjs').hashSync('your-password', 12))"
HOST_PASSWORD_HASH=
SESSION_SECRET=

# Neon free connection string (pooled). Leave empty to use the local file
# data/store.json when the process can write, or the built-in seed when it cannot.
# A Neon database is not created by this repo. Mateo connects the free Neon
# integration in the existing Vercel project, then this variable appears.
DATABASE_URL=

# Optional. Public pages use photos already in /public when this is unset.
# BLOB_READ_WRITE_TOKEN=
